generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String  @id @default(uuid())
  shop          String
  state         String
  isOnline      Boolean @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        Int?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean @default(false)
  locale        String?
  collaborator  Boolean @default(false)
  emailVerified Boolean @default(false)
}

model CustomerToken {
  id             String   @id @default(uuid())
  conversationId String
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
}

model CodeVerifier {
  id        String   @id @default(uuid())
  state     String   @unique
  verifier  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
}

model Message {
  id            String   @id @default(uuid())
  conversationId String
  role          String
  content       String
  createdAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model CustomerAccountUrl {
  id             String   @id @default(uuid())
  conversationId String   @unique
  url            String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AssistantCart {
  id             String   @id @default(uuid())
  shop           String
  cartId         String   @unique      // Shopify cart token / ID
  conversationId String?               // Link back to your Conversation if you have it
  createdAt      DateTime @default(now())

  items          AssistantCartItem[]
}

model AssistantCartItem {
  id               String   @id @default(uuid())
  assistantCartId  String
  productVariantId String
  quantity         Int
  createdAt        DateTime @default(now())

  cart AssistantCart @relation(fields: [assistantCartId], references: [id], onDelete: Cascade)

  @@index([assistantCartId])
  @@index([productVariantId])
}

model AssistantOrderAttribution {
  id              String   @id @default(uuid())
  shop            String
  orderId         String   @unique
  checkoutToken   String?          // from order.checkout_token
  totalAttributed Float            // sum of line items that were added by assistant
  currency        String?
  createdAt       DateTime @default(now())

  items           AssistantOrderItemAttribution[]
}

model AssistantOrderItemAttribution {
  id               String   @id @default(uuid())
  orderAttrId      String
  productVariantId String
  quantity         Int
  linePrice        Float
  createdAt        DateTime @default(now())

  orderAttr AssistantOrderAttribution @relation(fields: [orderAttrId], references: [id], onDelete: Cascade)

  @@index([orderAttrId])
  @@index([productVariantId])
}

model AssistantEvent {
  id               String   @id @default(uuid())
  eventType        String
  conversationId   String?
  productVariantId String?
  quantity         Int?
  checkoutUrl      String?
  createdAt        DateTime @default(now())
  rawPayload       Json?

  @@index([eventType])
  @@index([conversationId])
  @@index([productVariantId])
}
